import java.util.Scanner;

/**
 * Console interface. Reads and validates raw input, calls Library, and
 * prints Outcome messages. It never changes library state directly.
 */
public class LibraryMenu {
    public static final int MAX_TEXT = 100;

    private final Library library;
    private final Scanner in;

    public LibraryMenu(Library library, Scanner in) {
        this.library = library;
        this.in = in;
    }

    /** Main loop. Returns when the user chooses 0. */
    public void run() {
        while (true) {
            System.out.println();
            System.out.println("1) Add book      2) Add patron    3) Check out");
            System.out.println("4) Return        5) Place hold    6) Search");
            System.out.println("7) Show shelf    8) Remove book   9) Remove patron");
            System.out.println("0) Quit");
            int choice = readInt("Choice: ", 0, 9);
            if (choice == 0) {
                System.out.println("Goodbye.");
                return;
            }
            handle(choice);
        }
    }

    private void handle(int choice) {
        switch (choice) {
            case 1:
                show(library.addBook(readText("Title: "),
                    readText("Author: "), readText("Call number: ")));
                break;
            case 2:
                show(library.addPatron(readText("Patron ID: "),
                    readText("Name: ")));
                break;
            case 3:
                checkOut();
                break;
            case 4:
                show(library.returnBook(readText("Patron ID: "),
                    readInt("Copy #: ", 1, Integer.MAX_VALUE)));
                break;
            case 5:
                show(library.placeHold(readText("Patron ID: "),
                    readText("Call number: ")));
                break;
            case 6:
                LinkedChain<Book> found = library.search(readText("Search: "));
                if (found.isEmpty()) {
                    System.out.println("No matches.");
                }
                for (int i = 0; i < found.size(); i++) {
                    System.out.println(found.get(i));
                }
                break;
            case 7:
                System.out.println(library.shelfReport());
                break;
            case 8:
                show(library.removeBook(
                    readInt("Copy #: ", 1, Integer.MAX_VALUE)));
                break;
            case 9:
                show(library.removePatron(readText("Patron ID: ")));
                break;
            default:
                break;
        }
    }

    /** Checkout, offering a hold if every copy is out. */
    private void checkOut() {
        String id = readText("Patron ID: ");
        String call = readText("Call number: ");
        Outcome result = library.checkOut(id, call);
        show(result);
        if (result == Outcome.NONE_AVAILABLE
            && readYesNo("Place a hold instead? (y/n): ")) {
            show(library.placeHold(id, call));
        }
    }

    private void show(Outcome outcome) {
        System.out.println(outcome.getMessage());
    }

    /** Re-prompts until the line is a whole number in [min, max]. */
    public int readInt(String prompt, int min, int max) {
        while (true) {
            System.out.print(prompt);
            String line = in.nextLine().trim();
            try {
                int value = Integer.parseInt(line);
                if (value >= min && value <= max) {
                    return value;
                }
            }
            catch (NumberFormatException e) {
                // fall through to the message below
            }
            System.out.println("Enter a whole number from " + min
                + " to " + max + ".");
        }
    }

    /** Re-prompts until the text is non-blank and at most MAX_TEXT chars. */
    public String readText(String prompt) {
        while (true) {
            System.out.print(prompt);
            String line = in.nextLine().trim();
            if (line.isEmpty()) {
                System.out.println("This can't be blank.");
            }
            else if (line.length() > MAX_TEXT) {
                System.out.println("Too long (max " + MAX_TEXT
                    + " characters).");
            }
            else {
                return line;
            }
        }
    }

    /** Re-prompts until the answer is y or n. */
    public boolean readYesNo(String prompt) {
        while (true) {
            System.out.print(prompt);
            String line = in.nextLine().trim().toLowerCase();
            if (line.equals("y")) {
                return true;
            }
            if (line.equals("n")) {
                return false;
            }
            System.out.println("Please enter y or n.");
        }
    }
}
